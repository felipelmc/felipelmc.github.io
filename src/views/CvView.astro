---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PageIndex from '../components/ui/PageIndex.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { cv } from '../data/cv';
import { profile } from '../data/profile';
import type { CvRow, Locale } from '../data/types';
import { getLocalePath, tr, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const other = locale === 'en' ? 'pt-br' : 'en';

const rowGroups: { id: string; title: string; rows: CvRow[]; noteHtml?: string }[] = [
  { id: 'education', title: t('cv.education'), rows: cv.education },
  { id: 'scholarships', title: t('cv.scholarships'), rows: cv.scholarships },
  { id: 'distinctions', title: t('cv.distinctions'), rows: cv.distinctions },
  {
    id: 'training',
    title: t('cv.conferences'),
    rows: cv.training,
    noteHtml: t('cv.trainingNote').replace('{href}', `${getLocalePath(locale, '/publications')}#talks`),
  },
];
const sections = [
  { id: 'affiliations', label: t('cv.affiliations') },
  ...rowGroups.map((g) => ({ id: g.id, label: g.title })),
  { id: 'references', label: t('cv.references') },
];
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
---

<Layout title={t('cv.title')} description={t('cv.subtitle')}>
  <PageHeader kicker={t('cv.kicker')} title={t('cv.title')} subtitle={t('cv.subtitle')}>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a href={profile.cvPdf[locale]} class="btn-primary" target="_blank" rel="noopener noreferrer">
        <Icon name="download" class="h-4 w-4" />{t('cv.download')}
      </a>
      <a href={profile.cvPdf[other]} class="btn-ghost" target="_blank" rel="noopener noreferrer">{t('cv.downloadOther')}</a>
      <span class="meta">{cv.lastUpdated[locale]}</span>
    </div>
  </PageHeader>

  <div class="grid gap-10 lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-16">
    <PageIndex items={sections} label={t('cv.title')} />

    <div class="min-w-0 space-y-20">
      <section aria-labelledby="affiliations">
        <SectionHeader number={num('affiliations')} id="affiliations" title={t('cv.affiliations')} />
        <div class="grid gap-6">
          {cv.affiliations.map((a) => (
            <article class="card p-5 sm:p-6">
              <h3 class="text-lg font-semibold text-ink">
                {a.role[locale]} <span class="font-normal text-ink-3">@</span>{' '}
                {a.orgUrl ? <a href={a.orgUrl} class="link" target="_blank" rel="noopener noreferrer">{a.org}</a> : a.org}
              </h3>
              {a.descriptionHtml && <p class="mt-2 max-w-prose leading-relaxed text-ink-2" set:html={a.descriptionHtml[locale]} />}
              {a.labs && (
                <ul class="mt-4 grid gap-px overflow-hidden rounded-btn border border-line bg-line md:grid-cols-3">
                  {a.labs.map((lab) => (
                    <li class="flex flex-col gap-1.5 bg-panel p-4">
                      <p class="font-medium text-ink"><a href={lab.url} class="link" target="_blank" rel="noopener noreferrer">{lab.name}</a></p>
                      <p class="meta">{t('cv.coordinatedBy')} {lab.coordinators}</p>
                      <p class="text-sm leading-relaxed text-ink-2">{lab.description[locale]}</p>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>

      {rowGroups.map((g) => (
        <section aria-labelledby={g.id}>
          <SectionHeader number={num(g.id)} id={g.id} title={g.title} />
          {g.noteHtml && <p class="-mt-3 mb-6 max-w-prose text-sm text-ink-3" set:html={g.noteHtml} />}
          <ol class="divide-y divide-line">
            {g.rows.map((r) => (
              <li class="grid gap-x-6 gap-y-1 py-3.5 first:pt-0 sm:grid-cols-[8rem_1fr]">
                <p class="meta pt-1">{tr(r.when, locale)}</p>
                <div class="min-w-0">
                  <p class="leading-relaxed text-ink" set:html={tr(r.html, locale)} />
                  {r.subHtml && <p class="text-sm text-ink-3" set:html={tr(r.subHtml, locale)} />}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <section aria-labelledby="references">
        <SectionHeader number={num('references')} id="references" title={t('cv.references')} />
        <div class="overflow-x-auto rounded-card border border-line bg-panel">
          <table class="w-full min-w-[40rem] text-left text-sm">
            <thead class="border-b border-line bg-sunken/60">
              <tr>
                <th scope="col" class="px-4 py-3 font-mono text-meta font-medium uppercase tracking-[0.06em] text-ink-3">{t('cv.name')}</th>
                <th scope="col" class="px-4 py-3 font-mono text-meta font-medium uppercase tracking-[0.06em] text-ink-3">{t('cv.institution')}</th>
                <th scope="col" class="px-4 py-3 font-mono text-meta font-medium uppercase tracking-[0.06em] text-ink-3">{t('cv.whatFor')}</th>
                <th scope="col" class="px-4 py-3 font-mono text-meta font-medium uppercase tracking-[0.06em] text-ink-3">{t('cv.email')}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {cv.references.map((r) => (
                <tr>
                  <td class="px-4 py-3 font-medium text-ink">{r.name}</td>
                  <td class="px-4 py-3 text-ink-2">{r.institution}</td>
                  <td class="px-4 py-3 text-ink-2">{r.role[locale]}</td>
                  <td class="px-4 py-3 font-mono text-[0.75rem] text-ink-3">{r.email}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</Layout>
