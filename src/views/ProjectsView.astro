---
import Layout from '../layouts/Layout.astro';
import LinkList from '../components/LinkList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { clientWork, projects } from '../data/projects';
import type { Locale, ProjectCategory } from '../data/types';
import { getLocalePath, tr, useTranslations, type TranslationKey } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const featured = projects.filter((p) => p.tier === 'featured');
const standard = projects.filter((p) => p.tier === 'standard');
const compact = projects.filter((p) => p.tier === 'compact');
const years = projects.map((p) => p.year);
const categories = (['ai', 'apps', 'data', 'software', 'viz'] as ProjectCategory[])
  .map((c) => ({ c, n: projects.filter((p) => p.categories.includes(c)).length }))
  // A filter that isolates a single project isn't worth a button.
  .filter(({ n }) => n >= 2);
const catLabel = (c: ProjectCategory) => t(`projects.cat.${c}` as TranslationKey);
const count = t('projects.count').replace('{n}', String(projects.length));
---

<Layout title={t('projects.title')} description={t('meta.projects')}>
  <PageHeader kicker={`${count} · ${Math.min(...years)}–${Math.max(...years)}`} title={t('projects.title')} subtitle={t('projects.subtitle')} />

  <div class="grid gap-8 lg:grid-cols-rail lg:gap-16">
    <!-- The category filter: a list in the rail from lg up, a row of chips
         below it. Hidden until the script below runs. -->
    <div id="project-filters" role="group" aria-label={t('projects.filter')} class="-mx-4 overflow-x-auto px-4 lg:sticky lg:top-24 lg:mx-0 lg:self-start lg:overflow-visible lg:px-0" data-print-hide hidden>
      <p class="eyebrow mb-3 hidden lg:block" aria-hidden="true">{t('projects.filterLabel')}</p>
      <div class="flex w-max gap-2 pb-1 lg:w-auto lg:flex-col lg:gap-0 lg:border-l lg:border-line lg:pb-0">
        <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">{t('projects.all')}<span>{projects.length}</span></button>
        {categories.map(({ c, n }) => (
          <button type="button" class="filter-chip" data-filter={c} aria-pressed="false">
            {catLabel(c)}
            <span>{n}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="min-w-0">
  <section data-project-group aria-label={t('projects.title')}>
    <div class="divide-y divide-line [&>*]:py-7 [&>*:first-child]:pt-0">
      {featured.map((p, i) => <ProjectCard project={p} locale={locale} variant="featured" eager={i < 2} as="h2" />)}
    </div>
    {projects.some((p) => p.coldStart) && (
      <p class="meta mt-4 flex items-center gap-1.5"><Icon name="moon" class="h-3 w-3" />{t('projects.coldStartNote')}</p>
    )}
  </section>

  <section class="mt-16" data-project-group aria-labelledby="more-projects">
    <SectionHeader id="more-projects" title={t('projects.more')} />
    <div class="divide-y divide-line [&>*]:py-7 [&>*:first-child]:pt-0">
      {standard.map((p) => <ProjectCard project={p} locale={locale} />)}
    </div>

    {compact.length > 0 && (
    <ul class="mt-10 divide-y divide-line border-y border-line">
      {compact.map((p) => (
        <li id={p.slug} data-project data-categories={p.categories.join(' ')} class="grid scroll-mt-24 gap-x-6 gap-y-1 py-4 sm:grid-cols-[4rem_minmax(0,16rem)_1fr_auto] sm:items-baseline">
          <span class="meta">{p.year}</span>
          <h3 class="font-medium text-ink">{tr(p.title, locale)}</h3>
          <p class="text-sm text-ink-2">
            {p.tagline[locale]}
            {p.coursework && <span class="chip ml-1 align-middle">{t('projects.coursework')}</span>}
          </p>
          <div class="flex gap-4"><LinkList links={p.links} locale={locale} /></div>
        </li>
      ))}
    </ul>
    )}
  </section>

  <section class="mt-16" aria-labelledby="client-work">
    <SectionHeader id="client-work" title={t('projects.clientWork')} />
    <p class="-mt-3 mb-6 max-w-prose text-sm text-ink-3">{t('projects.clientWorkNote')}</p>
    <ul class="divide-y divide-line">
      {clientWork.map((w) => (
        <li class="grid gap-x-6 gap-y-1 py-4 first:pt-0 sm:grid-cols-dated">
          <p class="meta sm:pt-0.5">{w.when}</p>
          <p class="max-w-prose text-small text-ink-2"><span class="font-semibold text-ink">{w.who}.</span> {w.what[locale]}</p>
        </li>
      ))}
    </ul>
  </section>

  <p class="mt-14 border-t border-line pt-5 text-small text-ink-2">
    <a href={`${getLocalePath(locale, '/teaching')}#notes`} class="link">{t('projects.notesCta')}</a>
  </p>
    </div>
  </div>
</Layout>

<style>
  /* A chip in the scrolling row below lg; a line of the rail's list from lg up. */
  .filter-chip {
    @apply inline-flex shrink-0 items-baseline gap-2 rounded-btn border border-line px-3 py-1 text-sm text-ink-2 transition-colors duration-150 hover:border-line-strong hover:text-ink;
    @apply lg:-ml-px lg:justify-between lg:rounded-none lg:border-0 lg:border-l-2 lg:border-transparent lg:py-1 lg:pl-4 lg:pr-0 lg:text-left lg:hover:border-transparent lg:hover:text-accent;
  }
  .filter-chip span {
    @apply text-[0.75rem] tabular-nums text-ink-3;
  }
  .filter-chip[aria-pressed='true'] {
    @apply border-accent bg-accent text-accent-ink lg:border-accent lg:bg-transparent lg:font-semibold lg:text-ink lg:hover:border-accent lg:hover:text-ink;
  }
  .filter-chip[aria-pressed='true'] span {
    @apply text-accent-ink/75 lg:font-normal lg:text-ink-3;
  }
</style>

<script>
  // Progressive enhancement: without JS every project is listed and the
  // filter bar stays hidden.
  const bar = document.getElementById('project-filters');
  if (bar) {
    bar.hidden = false;
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-project-group]'));

    const apply = (filter: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      items.forEach((el) => {
        const match = filter === 'all' || (el.dataset.categories ?? '').split(' ').includes(filter);
        el.hidden = !match;
      });
      groups.forEach((g) => {
        g.hidden = !g.querySelector('[data-project]:not([hidden])');
      });
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
  }
</script>
