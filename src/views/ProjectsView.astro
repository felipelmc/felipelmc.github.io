---
import Layout from '../layouts/Layout.astro';
import LinkList from '../components/LinkList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { clientWork, projects } from '../data/projects';
import type { Locale, ProjectCategory } from '../data/types';
import { getLocalePath, tr, useTranslations, type TranslationKey } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const featured = projects.filter((p) => p.tier === 'featured');
const standard = projects.filter((p) => p.tier === 'standard');
const compact = projects.filter((p) => p.tier === 'compact');
const years = projects.map((p) => p.year);
const categories = (['ai', 'apps', 'data', 'software', 'viz'] as ProjectCategory[])
  .map((c) => ({ c, n: projects.filter((p) => p.categories.includes(c)).length }))
  // A filter that isolates a single project isn't worth a button.
  .filter(({ n }) => n >= 2);
const catLabel = (c: ProjectCategory) => t(`projects.cat.${c}` as TranslationKey);
const count = t('projects.count').replace('{n}', String(projects.length));
---

<Layout title={t('projects.title')} description={t('meta.projects')}>
  <PageHeader kicker={`${count} · ${Math.min(...years)}–${Math.max(...years)}`} title={t('projects.title')} subtitle={t('projects.subtitle')} />

  <div id="project-filters" role="group" aria-label={t('projects.filter')} class="-mx-4 mb-10 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0" data-print-hide hidden>
    <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">{t('projects.all')}</button>
    {categories.map(({ c, n }) => (
      <button type="button" class="filter-chip" data-filter={c} aria-pressed="false">
        {catLabel(c)}
        <span class="text-ink-3">{n}</span>
      </button>
    ))}
  </div>

  <section data-project-group aria-label={t('projects.title')}>
    <div class="grid gap-6 md:grid-cols-2">
      {featured.map((p, i) => <ProjectCard project={p} locale={locale} variant="featured" eager={i < 2} as="h2" />)}
    </div>
    {projects.some((p) => p.coldStart) && (
      <p class="meta mt-4 flex items-center gap-1.5"><Icon name="moon" class="h-3 w-3" />{t('projects.coldStartNote')}</p>
    )}
  </section>

  <section class="mt-20" data-project-group aria-labelledby="more-projects">
    <SectionHeader id="more-projects" title={t('projects.more')} />
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {standard.map((p) => <ProjectCard project={p} locale={locale} />)}
    </div>

    {compact.length > 0 && (
    <ul class="mt-10 divide-y divide-line border-y border-line">
      {compact.map((p) => (
        <li id={p.slug} data-project data-categories={p.categories.join(' ')} class="grid scroll-mt-24 gap-x-6 gap-y-1 py-4 sm:grid-cols-[4rem_minmax(0,16rem)_1fr_auto] sm:items-baseline">
          <span class="meta">{p.year}</span>
          <h3 class:list={['text-ink', p.code ? 'font-mono text-[0.9375rem]' : 'font-medium']}>{tr(p.title, locale)}</h3>
          <p class="text-sm text-ink-2">
            {p.tagline[locale]}
            {p.coursework && <span class="chip ml-1 align-middle">{t('projects.coursework')}</span>}
          </p>
          <div class="flex gap-4"><LinkList links={p.links} locale={locale} /></div>
        </li>
      ))}
    </ul>
    )}
  </section>

  <section class="mt-20" aria-labelledby="client-work">
    <SectionHeader id="client-work" title={t('projects.clientWork')} />
    <p class="-mt-3 mb-6 max-w-prose text-sm text-ink-3">{t('projects.clientWorkNote')}</p>
    <ul class="grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {clientWork.map((w) => (
        <li class="bg-panel p-5">
          <p class="meta mb-2">{w.when} · {w.who}</p>
          <p class="text-sm leading-relaxed text-ink-2">{w.what[locale]}</p>
        </li>
      ))}
    </ul>
  </section>

  <a href={`${getLocalePath(locale, '/teaching')}#notes`} class="group mt-16 flex items-center justify-between gap-4 rounded-card border border-dashed border-line-strong px-5 py-4 text-ink-2 transition-colors duration-150 hover:border-accent hover:text-accent">
    <span>{t('projects.notesCta')}</span>
    <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-150 group-hover:translate-x-0.5" />
  </a>
</Layout>

<style>
  .filter-chip {
    @apply inline-flex shrink-0 items-center gap-2 rounded-full border border-line bg-panel px-3.5 py-1.5 text-sm text-ink-2 transition-colors duration-150 hover:border-line-strong hover:text-ink;
  }
  .filter-chip[aria-pressed='true'] {
    @apply border-accent bg-accent text-accent-ink;
  }
  .filter-chip[aria-pressed='true'] span {
    @apply text-accent-ink/75;
  }
</style>

<script>
  // Progressive enhancement: without JS every project is listed and the
  // filter bar stays hidden.
  const bar = document.getElementById('project-filters');
  if (bar) {
    bar.hidden = false;
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-project]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-project-group]'));

    const apply = (filter: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      items.forEach((el) => {
        const match = filter === 'all' || (el.dataset.categories ?? '').split(' ').includes(filter);
        el.hidden = !match;
      });
      groups.forEach((g) => {
        g.hidden = !g.querySelector('[data-project]:not([hidden])');
      });
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
  }
</script>
