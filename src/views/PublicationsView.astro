---
import Layout from '../layouts/Layout.astro';
import CiteDialog from '../components/CiteDialog.astro';
import LinkList from '../components/LinkList.astro';
import PubEntry from '../components/PubEntry.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PageIndex from '../components/ui/PageIndex.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { projects } from '../data/projects';
import { publications } from '../data/publications';
import { talks } from '../data/talks';
import type { Locale, PublicationType } from '../data/types';
import { getLocalePath, htmlLang, tr, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = htmlLang(locale);

const groups: { id: string; type: PublicationType; title: string }[] = [
  { id: 'dissertation', type: 'dissertation', title: t('research.dissertation') },
  { id: 'working-papers', type: 'working-paper', title: t('research.working') },
  { id: 'articles', type: 'article', title: t('research.articles') },
  { id: 'technical-notes', type: 'technical-note', title: t('publications.technical') },
].filter((g) => publications.some((p) => p.type === g.type));

const software = projects.filter((p) => p.citation);

const sections = [
  ...groups.map((g) => ({ id: g.id, label: g.title })),
  { id: 'talks', label: t('publications.presentations') },
  ...(software.length ? [{ id: 'software', label: t('research.software') }] : []),
];
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
---

<Layout title={t('research.title')} description={t('research.subtitle')}>
  <PageHeader kicker={t('research.kicker')} title={t('research.title')} subtitle={t('research.subtitle')} />

  <div class="grid gap-10 lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-16">
    <PageIndex items={sections} label={t('research.title')} />

    <div class="min-w-0 space-y-20">
      {groups.map((g) => (
        <section aria-labelledby={g.id}>
          <SectionHeader number={num(g.id)} id={g.id} title={g.title} />
          <div>
            {publications.filter((p) => p.type === g.type).map((pub) => <PubEntry pub={pub} locale={locale} />)}
          </div>
        </section>
      ))}

      <section aria-labelledby="talks">
        <SectionHeader number={num('talks')} id="talks" title={t('publications.presentations')} />
        <ol class="divide-y divide-line">
          {talks.map((talk) => (
            <li class="grid gap-x-6 gap-y-1 py-5 first:pt-0 sm:grid-cols-[8rem_1fr]">
              <p class="meta flex flex-wrap items-center gap-2 pt-0.5">
                {talk.dateLabel[locale]}
                {talk.upcoming && <span class="chip-accent">{t('common.upcoming')}</span>}
              </p>
              <div class="min-w-0">
                <p class="font-medium leading-snug text-ink">
                  {talk.eventUrl ? (
                    <a href={talk.eventUrl} class="transition-colors duration-150 hover:text-accent" target="_blank" rel="noopener noreferrer">{tr(talk.event, locale)}</a>
                  ) : tr(talk.event, locale)}
                </p>
                {talk.detail && <p class="text-sm text-ink-3">{tr(talk.detail, locale)}</p>}
                <p class="mt-2 font-serif text-[1.0625rem] italic leading-snug text-ink-2" lang={talk.titleLang && talk.titleLang !== lang ? talk.titleLang : undefined}>
                  <em>{talk.title}</em>
                </p>
                {(talk.links?.length || talk.publicationId) && (
                  <div class="mt-2.5 flex flex-wrap items-baseline gap-x-5 gap-y-2">
                    {talk.publicationId && (
                      <a href={`#${talk.publicationId}`} class="action">{t('link.paper')}<Icon name="arrow-right" class="h-3 w-3" /></a>
                    )}
                    {talk.links && <LinkList links={talk.links} locale={locale} />}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {software.length > 0 && (
        <section aria-labelledby="software">
          <SectionHeader number={num('software')} id="software" title={t('research.software')} />
          <p class="-mt-3 mb-6 max-w-prose text-sm text-ink-3">{t('research.softwareNote')}</p>
          <ul class="divide-y divide-line">
            {software.map((p) => (
              <li class="grid gap-x-6 gap-y-1 py-5 first:pt-0 sm:grid-cols-[4rem_1fr]">
                <p class="meta pt-1">{p.year}</p>
                <div class="min-w-0">
                  <h3 class:list={['text-[1.0625rem] font-semibold text-ink', p.code && 'font-mono']}>{tr(p.title, locale)}</h3>
                  <p class="mt-1 text-[0.9375rem] text-ink-2">{p.tagline[locale]}</p>
                  <div class="mt-2.5 flex flex-wrap items-baseline gap-x-5 gap-y-2">
                    <LinkList links={p.links.filter((l) => l.kind === 'doi')} locale={locale} />
                    <button type="button" class="action" data-dialog={`cite-${p.citation!.key}`}>{t('common.bibtex')}</button>
                    <a href={`${getLocalePath(locale, '/projects')}#${p.slug}`} class="action">{t('nav.projects')}<Icon name="arrow-right" class="h-3 w-3" /></a>
                  </div>
                </div>
                <CiteDialog citation={p.citation!} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Layout>
