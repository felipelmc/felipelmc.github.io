---
import Layout from '../layouts/Layout.astro';
import CiteDialog from '../components/CiteDialog.astro';
import LinkList from '../components/LinkList.astro';
import PubEntry from '../components/PubEntry.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import PageIndex from '../components/ui/PageIndex.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { projects } from '../data/projects';
import { publications } from '../data/publications';
import { talks } from '../data/talks';
import type { Locale, PublicationType } from '../data/types';
import { getLocalePath, htmlLang, tr, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lang = htmlLang(locale);

// Written work is split by kind, in this order, because the kinds do not weigh
// the same; inside a group, newest first. Only the last group mixes two types,
// so only there each entry shows its type under the year. A hairline separates
// one group from the next; papers within a group are separated by space alone.
const groupTypes: { id: string; label: string; types: PublicationType[] }[] = [
  { id: 'papers-dissertation', label: t('research.group.dissertation'), types: ['dissertation'] },
  { id: 'papers-working', label: t('research.group.working'), types: ['working-paper'] },
  { id: 'papers-peer', label: t('research.group.peer'), types: ['article'] },
  { id: 'papers-other', label: t('research.group.other'), types: ['discussion-paper', 'technical-note'] },
];
const groups = groupTypes
  .map((g) => ({
    ...g,
    papers: publications
      .filter((p) => g.types.includes(p.type))
      .sort((a, b) => b.year - a.year || g.types.indexOf(a.type) - g.types.indexOf(b.type)),
  }))
  .filter((g) => g.papers.length);

const software = projects.filter((p) => p.citation);

const sections = [
  { id: 'papers', label: t('research.papers') },
  { id: 'talks', label: t('publications.presentations') },
  ...(software.length ? [{ id: 'software', label: t('research.software') }] : []),
];
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
---

<Layout title={t('research.title')} description={t('meta.research')}>
  <PageHeader kicker={t('research.kicker')} title={t('research.title')} subtitle={t('research.subtitle')} />

  <div class="grid gap-10 lg:grid-cols-rail lg:gap-16">
    <PageIndex items={sections} label={t('research.title')} />

    <div class="min-w-0 space-y-16">
      <section aria-labelledby="papers">
        <SectionHeader gutter number={num('papers')} id="papers" title={t('research.papers')} />
        <div>
          {groups.map((g) => (
            <div class="mt-8 border-t border-line pt-8 first:mt-0 first:border-t-0 first:pt-0">
              <h3 id={g.id} class="eyebrow mb-4 scroll-mt-24 text-[0.9375rem] text-ink-2 sm:pl-[8.5rem]">{g.label}</h3>
              <div>
                {g.papers.map((pub) => <PubEntry pub={pub} locale={locale} as="h4" showType={g.types.length > 1} />)}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section aria-labelledby="talks">
        <SectionHeader gutter number={num('talks')} id="talks" title={t('publications.presentations')} href="https://felipelamarca.com/Presentations/" hrefLabel={t('common.allSlides')} />
        <ol class="divide-y divide-line">
          {talks.map((talk) => (
            <li class="grid gap-x-6 gap-y-1 py-5 first:pt-0 sm:grid-cols-[7rem_minmax(0,1fr)]">
              <p class="meta flex flex-wrap items-center gap-2 self-start pt-1">
                {talk.dateLabel[locale]}
                {talk.upcoming && <span class="chip-accent">{t('common.upcoming')}</span>}
              </p>
              <div class="min-w-0">
                <p class="entry-title">
                  {talk.eventUrl ? (
                    <a href={talk.eventUrl} class="transition-colors duration-150 hover:text-accent" target="_blank" rel="noopener noreferrer">{tr(talk.event, locale)}</a>
                  ) : tr(talk.event, locale)}
                </p>
                {talk.detail && <p class="text-sm text-ink-3">{tr(talk.detail, locale)}</p>}
                <p class="mt-2 font-serif text-[1.0625rem] italic leading-snug text-ink-2" lang={talk.titleLang && talk.titleLang !== lang ? talk.titleLang : undefined}>
                  <em>{talk.title}</em>
                </p>
                {(talk.links?.length || talk.publicationId) && (
                  <div class="mt-2.5 flex flex-wrap items-baseline gap-x-5 gap-y-2">
                    {talk.publicationId && (
                      <a href={`#${talk.publicationId}`} class="action">{t('link.paper')}</a>
                    )}
                    {talk.links && <LinkList links={talk.links} locale={locale} />}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      {software.length > 0 && (
        <section aria-labelledby="software">
          <SectionHeader gutter number={num('software')} id="software" title={t('research.software')} />
          <p class="-mt-3 mb-6 max-w-prose text-sm text-ink-3 sm:pl-[8.5rem]">{t('research.softwareNote')}</p>
          <ul class="divide-y divide-line">
            {software.map((p) => (
              <li class="grid gap-x-6 gap-y-1 py-5 first:pt-0 sm:grid-cols-[7rem_minmax(0,1fr)]">
                <p class="meta pt-1">{p.year}</p>
                <div class="min-w-0">
                  <h3 class="entry-title">{tr(p.title, locale)}</h3>
                  <p class="mt-1 max-w-prose text-small text-ink-2">{p.tagline[locale]}</p>
                  <div class="mt-2.5 flex flex-wrap items-baseline gap-x-5 gap-y-2">
                    <LinkList links={p.links.filter((l) => l.kind === 'doi')} locale={locale} />
                    <button type="button" class="action" data-dialog={`cite-${p.citation!.key}`}>{t('common.bibtex')}</button>
                    <a href={`${getLocalePath(locale, '/projects')}#${p.slug}`} class="action">{t('nav.projects')}</a>
                  </div>
                </div>
                <CiteDialog citation={p.citation!} locale={locale} />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Layout>
