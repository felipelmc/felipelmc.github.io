---
// GitHub Pages serves docs/404.html for any unknown path. The locale is
// unknown here, so the page speaks both languages.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/ui/Icon.astro';
import { useTranslations } from '../i18n/utils';

const en = useTranslations('en');
const pt = useTranslations('pt-br');
---

<Layout title={en('notFound.title')} description={en('notFound.body')}>
  <section class="mx-auto grid max-w-3xl gap-12 py-10 sm:grid-cols-2">
    <p class="font-mono text-display font-semibold text-accent sm:col-span-2">404</p>
    <div class="space-y-3">
      <h1 class="text-2xl font-semibold tracking-[-0.02em] text-ink">{en('notFound.title')}</h1>
      <p class="text-ink-2">{en('notFound.body')}</p>
      <a href="/" class="btn-primary mt-2">{en('notFound.home')}<Icon name="arrow-right" class="h-4 w-4" /></a>
    </div>
    <div class="space-y-3" lang="pt-BR">
      <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink">{pt('notFound.title')}</h2>
      <p class="text-ink-2">{pt('notFound.body')}</p>
      <a href="/pt-br/" class="btn-ghost mt-2">{pt('notFound.home')}<Icon name="arrow-right" class="h-4 w-4" /></a>
    </div>
  </section>
</Layout>
