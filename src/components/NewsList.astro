---
// News on the home page: the newest items side by side, each under its date
// (an item marked `upcoming` gets the accent and an "Upcoming" tag), and the
// older ones as a dated list behind an "Earlier" disclosure.
import { news } from '../data/news';
import type { Locale } from '../data/types';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** How many items sit side by side. */
  limit?: number;
}

const { locale, limit = 3 } = Astro.props;
const t = useTranslations(locale);
const recent = news.slice(0, limit);
const earlier = news.slice(limit);
---

<ol class="grid gap-x-10 gap-y-6 md:grid-cols-3">
  {recent.map((item) => (
    <li id={`news-${item.date}`} class="scroll-mt-24">
      <p class:list={['meta flex flex-wrap items-center gap-x-2 gap-y-1', item.upcoming && '!text-accent']}>
        <span class:list={[item.upcoming && 'font-semibold']}>{item.label[locale]}</span>
        {item.upcoming && <span class="chip-accent">{t('common.upcoming')}</span>}
      </p>
      <p class="mt-1 text-small text-ink-2 text-pretty">{item.text[locale]}</p>
    </li>
  ))}
</ol>

{earlier.length > 0 && (
  <details class="mt-6">
    <summary class="action cursor-pointer list-none [&::-webkit-details-marker]:hidden">{t('home.earlierNews')}</summary>
    <ol class="mt-4 divide-y divide-line">
      {earlier.map((item) => (
        <li id={`news-${item.date}`} class="grid scroll-mt-24 gap-x-6 gap-y-1 py-3 first:pt-0 last:pb-0 sm:grid-cols-dated">
          <p class="meta sm:pt-0.5">{item.label[locale]}</p>
          <p class="max-w-prose text-small text-ink-2 text-pretty">{item.text[locale]}</p>
        </li>
      ))}
    </ol>
  </details>
)}
