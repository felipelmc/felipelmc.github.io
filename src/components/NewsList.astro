---
// News as a timeline: mono date label, a dot on a 1px rule, the text.
import Icon from './ui/Icon.astro';
import { news } from '../data/news';
import type { Locale } from '../data/types';
import { getLocalePath, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  limit?: number;
}

const { locale, limit } = Astro.props;
const t = useTranslations(locale);
const items = limit ? news.slice(0, limit) : news;
---

<ol class="relative max-w-3xl">
  <span class="absolute bottom-3 left-[0.3125rem] top-3 w-px bg-line sm:left-[7.3125rem]" aria-hidden="true"></span>
  {items.map((item, i) => (
    <li id={`news-${item.date}`} class="relative grid scroll-mt-24 gap-1 pb-6 pl-6 last:pb-0 sm:grid-cols-[6.5rem_1fr] sm:gap-8 sm:pl-0">
      <span
        class:list={[
          'absolute left-0 top-[0.5rem] h-[11px] w-[11px] rounded-full border-2 border-canvas sm:left-[6.8125rem]',
          i === 0 ? 'bg-accent' : 'bg-line-strong',
        ]}
        aria-hidden="true"
      ></span>
      <p class="meta pt-1">{item.label[locale]}</p>
      <p class="leading-relaxed text-ink-2 sm:pl-4">
        {item.text[locale]}
        {item.href && (
          <a href={getLocalePath(locale, item.href)} class="link ml-1 whitespace-nowrap text-sm">
            {t('common.more')}<Icon name="arrow-right" class="ml-0.5 inline h-3 w-3" />
          </a>
        )}
      </p>
    </li>
  ))}
</ol>
