---
// Fig. 1 with its caption, colour key and sources. The dots themselves are
// generated by scripts/build-map.py into BrazilDots.astro; the numbers used
// here come from src/data/figure.ts, written by the same script.
import BrazilDots from './BrazilDots.astro';
import { fig1 } from '../../data/figure';
import type { Locale } from '../../data/types';
import { htmlLang, useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
const lang = htmlLang(locale);
const count = new Intl.NumberFormat(lang).format(fig1.count);
const pct = (v: number, digits = 0) => new Intl.NumberFormat(lang, { style: 'percent', maximumFractionDigits: digits, minimumFractionDigits: digits }).format(v);
const ramp = ['--d1', '--d2', '--d3', '--d4', '--d5'];
const variable = fig1.variable ? fig1.variable[locale] : null;
// Bin boundaries: min, the four inner breaks, max.
const edges = fig1.bins.length ? [fig1.bins[0].from, ...fig1.bins.map((b) => b.to)] : [];
---

<figure class:list={['relative', className]}>
  <BrazilDots class="h-auto w-full" />
  <figcaption class="mt-4 space-y-3 border-t border-line pt-3">
    <p class="text-sm leading-relaxed text-ink-2">
      <span class="font-mono text-meta font-medium text-ink">{t('fig.label')}</span>
      <span class="text-ink-3"> — </span>
      {t('fig.dots').replace('{n}', count)}
      {variable && <> {t('fig.color').replace('{v}', variable)}</>}
      {'national' in fig1 && typeof fig1.national === 'number' && <> {t('fig.national').replace('{p}', pct(fig1.national, 1))}</>}
    </p>
    {edges.length > 0 && (
      <>
        <div class="w-fit" aria-hidden="true">
          <div class="flex overflow-hidden rounded-full">
            {ramp.map((v) => <span class="h-2.5 w-10" style={`background: rgb(var(${v}))`}></span>)}
          </div>
          <div class="relative mt-1.5 h-4 font-mono text-[0.6875rem] tabular-nums text-ink-3" style={`width: ${ramp.length * 2.5}rem`}>
            {edges.map((e, i) => (
              <span class="absolute -translate-x-1/2" style={`left: ${(i / ramp.length) * 100}%`}>{pct(e)}</span>
            ))}
          </div>
        </div>
        <ul class="sr-only">
          {fig1.bins.map((b) => (
            <li>{pct(b.from, 1)}–{pct(b.to, 1)}: {new Intl.NumberFormat(lang).format(b.n)} {t('fig.municipalities')}</li>
          ))}
        </ul>
      </>
    )}
    <p class="meta">
      {t('fig.source')}:{' '}
      {fig1.sources.map((s, i) => (
        <>{i > 0 && '; '}<a href={s.url} class="underline decoration-line-strong underline-offset-2 hover:text-accent" target="_blank" rel="noopener noreferrer">{s.name}</a></>
      ))}
    </p>
  </figcaption>
</figure>
