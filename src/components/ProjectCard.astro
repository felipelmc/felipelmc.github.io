---
// A project card. With a screenshot, the image sits in a browser-like frame
// whose address bar shows the real domain; without one, the card is text only.
// Variants: `featured` (Projects page top: large stats, the long description
// behind a "Details" disclosure), `standard` (Projects grid), `home` (home
// page: slimmer, fixed image height per row; below `sm` it collapses to a
// compact row with a small thumbnail, the title and the tagline).
import CiteDialog from './CiteDialog.astro';
import LinkList from './LinkList.astro';
import Icon from './ui/Icon.astro';
import type { Locale, Project } from '../data/types';
import { joinPeople, tr, useTranslations } from '../i18n/utils';

interface Props {
  project: Project;
  locale: Locale;
  variant?: 'featured' | 'standard' | 'home';
  /** Image is above the fold: load eagerly. */
  eager?: boolean;
  as?: 'h2' | 'h3';
  class?: string;
}

const { project: p, locale, variant = 'standard', eager = false, as: Title = 'h3', class: className } = Astro.props;
const t = useTranslations(locale);
const featured = variant === 'featured';
const home = variant === 'home';
const primary = p.links.find((l) => ['live', 'site', 'data'].includes(l.kind)) ?? p.links[0];
const image = p.shot ? (p.shot.image ?? p.slug) : undefined;
const title = tr(p.title, locale);
const showStack = !home && (p.stack?.length || p.coursework || p.privateDeployment);
---

<article
  id={p.slug}
  data-project
  data-categories={p.categories.join(' ')}
  class:list={['card group/card flex scroll-mt-24 overflow-hidden transition-[border-color,box-shadow] duration-150 hover:border-line-strong hover:shadow-lift', home ? 'flex-row sm:flex-col' : 'flex-col', className]}
>
  {image && (
    <>
      <div class:list={['h-7 items-center gap-2 border-b border-line bg-sunken px-3', home ? 'hidden sm:flex' : 'flex']} aria-hidden="true">
        <span class="h-2 w-2 shrink-0 rounded-full border border-line-strong"></span>
        <span class="truncate font-mono text-meta text-ink-3">{p.shot!.domain}</span>
      </div>
      <div class:list={['relative overflow-hidden border-line bg-sunken', home ? 'w-[6.5rem] shrink-0 border-r sm:aspect-[16/10] sm:w-auto sm:border-b sm:border-r-0 md:aspect-auto md:h-[15rem] lg:h-[18rem]' : 'aspect-[16/10] border-b']}>
        <img
          src={`/img/projects/thumbs/${image}.webp`}
          srcset={`/img/projects/thumbs/${image}.webp 800w, /img/projects/${image}.webp 1600w`}
          sizes={featured ? '(min-width: 1024px) 36rem, (min-width: 768px) 50vw, 100vw' : home ? '(min-width: 1024px) 36rem, (min-width: 768px) 50vw, (min-width: 640px) 100vw, 7rem' : '(min-width: 1024px) 28rem, (min-width: 768px) 50vw, 100vw'}
          width="1600"
          height="1000"
          alt={p.shot!.alt[locale]}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class:list={['h-full w-full object-cover transition-[transform,filter] duration-300 ease-out motion-reduce:transition-none dark:brightness-[.8] dark:group-hover/card:brightness-100', home ? 'absolute inset-0 object-left-top sm:static sm:object-top sm:group-hover/card:-translate-y-1' : 'object-top group-hover/card:-translate-y-1']}
        />
      </div>
    </>
  )}

  <div class:list={['flex min-w-0 flex-1 flex-col', featured ? 'gap-3 p-5 sm:p-6' : home ? 'gap-1.5 p-4 sm:gap-2.5 sm:p-5' : 'gap-2.5 p-5']}>
    <p class="meta">
      {p.year}{p.context && <> · {tr(p.context, locale)}</>}
    </p>

    <Title class="text-h3 font-semibold text-ink">
      {primary ? (
        <a href={primary.href} target="_blank" rel="noopener noreferrer" class="transition-colors duration-150 hover:text-accent">{title}</a>
      ) : title}
    </Title>

    {p.award && (
      <p>
        {p.award.href ? (
          <a href={p.award.href} target="_blank" rel="noopener noreferrer" class="chip-award font-medium hover:bg-award/15">
            <Icon name="star" class="h-3 w-3" />{p.award.label[locale]}
          </a>
        ) : (
          <span class="chip-award font-medium"><Icon name="star" class="h-3 w-3" />{p.award.label[locale]}</span>
        )}
      </p>
    )}

    {(featured || home) && p.stats && (
      <dl class:list={['flex-wrap gap-x-6 gap-y-1', home ? 'hidden sm:flex' : 'flex']}>
        {p.stats.map((s) => (
          <div class="flex items-baseline gap-1.5">
            <dt class="sr-only">{s.label[locale]}</dt>
            <dd class:list={['font-mono font-medium tracking-[-0.02em] text-ink', featured ? 'text-[1.375rem] leading-tight' : 'text-base']}>{tr(s.value, locale)}</dd>
            <dd class="text-sm text-ink-3" aria-hidden="true">{s.label[locale]}</dd>
          </div>
        ))}
      </dl>
    )}

    <p class:list={['text-small text-ink-2 text-pretty', home && 'line-clamp-3 sm:line-clamp-none']}>{p.tagline[locale]}</p>
    {featured && p.descriptionHtml && (
      <details class="group">
        <summary class="action cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          {t('common.details')}
          <span class="inline-block transition-transform duration-150 group-open:rotate-180" aria-hidden="true">↓</span>
        </summary>
        <p class="mt-2 text-sm leading-relaxed text-ink-3" set:html={p.descriptionHtml[locale]} />
      </details>
    )}

    {!home && p.collaborators?.length && (
      <p class="text-sm text-ink-3">{t('common.jointWith')} {joinPeople(p.collaborators, locale)}.</p>
    )}

    <div class:list={['mt-auto flex-col gap-3 pt-2', home ? 'hidden sm:flex' : 'flex']}>
      {showStack && (
        <ul class="flex flex-wrap gap-1.5">
          {p.privateDeployment && <li class="chip">{t('projects.private')}</li>}
          {p.coursework && <li class="chip">{t('projects.coursework')}</li>}
          {p.stack?.map((s) => <li class="chip-stack">{s}</li>)}
        </ul>
      )}
      {(p.links.length > 0 || p.citation) && (
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 border-t border-line pt-3">
          <LinkList links={p.links} locale={locale} coldStart={p.coldStart} />
          {p.citation && <button type="button" class="action" data-dialog={`cite-${p.citation.key}`}>{t('common.bibtex')}</button>}
        </div>
      )}
    </div>
  </div>
  {p.citation && <CiteDialog citation={p.citation} locale={locale} />}
</article>
