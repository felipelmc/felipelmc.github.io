---
// A project, as a row: a small screenshot on the left (when there is one),
// the text on the right. Variants: `featured` (Projects page top: larger
// image, the stats in a line, the long description behind a "Details"
// disclosure) and `standard` (the rest of the Projects page).
import CiteDialog from './CiteDialog.astro';
import LinkList from './LinkList.astro';
import Icon from './ui/Icon.astro';
import type { Locale, Project } from '../data/types';
import { joinPeople, tr, useTranslations } from '../i18n/utils';

interface Props {
  project: Project;
  locale: Locale;
  variant?: 'featured' | 'standard';
  /** Image is above the fold: load eagerly. */
  eager?: boolean;
  as?: 'h2' | 'h3';
  class?: string;
}

const { project: p, locale, variant = 'standard', eager = false, as: Title = 'h3', class: className } = Astro.props;
const t = useTranslations(locale);
const featured = variant === 'featured';
const primary = p.links.find((l) => ['live', 'site', 'data'].includes(l.kind)) ?? p.links[0];
const image = p.shot ? (p.shot.image ?? p.slug) : undefined;
const title = tr(p.title, locale);
const stack = [
  ...(p.privateDeployment ? [t('projects.private')] : []),
  ...(p.coursework ? [t('projects.coursework')] : []),
  ...(p.stack ?? []),
];
const columns = featured
  ? 'grid-cols-[6.5rem_minmax(0,1fr)] sm:grid-cols-[15rem_minmax(0,1fr)]'
  : 'grid-cols-[6.5rem_minmax(0,1fr)] sm:grid-cols-[11rem_minmax(0,1fr)]';
---

<article
  id={p.slug}
  data-project
  data-categories={p.categories.join(' ')}
  class:list={['grid scroll-mt-24 items-start gap-x-4 sm:gap-x-6', image && columns, className]}
>
  {image && (
    <img
      src={`/img/projects/thumbs/${image}.webp`}
      width="800"
      height="500"
      alt={p.shot!.alt[locale]}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="mt-1 aspect-[16/10] w-full rounded-chip border border-line bg-sunken object-cover object-top dark:brightness-90"
    />
  )}

  <div class="min-w-0">
    <Title class="entry-title">
      {primary ? (
        <a href={primary.href} target="_blank" rel="noopener noreferrer" class="transition-colors duration-150 hover:text-accent">{title}</a>
      ) : title}
    </Title>
    <p class="meta mt-0.5">
      {p.year}{p.context && <> · {tr(p.context, locale)}</>}
    </p>

    {p.award && (
      <p class="mt-2">
        {p.award.href ? (
          <a href={p.award.href} target="_blank" rel="noopener noreferrer" class="chip-award hover:border-award">
            <Icon name="star" class="h-3 w-3" />{p.award.label[locale]}
          </a>
        ) : (
          <span class="chip-award"><Icon name="star" class="h-3 w-3" />{p.award.label[locale]}</span>
        )}
      </p>
    )}

    <p class="mt-2 text-small text-ink-2 text-pretty">{p.tagline[locale]}</p>

    {featured && p.stats && (
      <dl class="mt-2 flex flex-wrap gap-x-5 gap-y-0.5 text-sm text-ink-3">
        {p.stats.map((s) => (
          <div class="flex items-baseline gap-1.5">
            <dt class="order-2">{s.label[locale]}</dt>
            <dd class="font-semibold text-ink">{tr(s.value, locale)}</dd>
          </div>
        ))}
      </dl>
    )}

    {featured && p.descriptionHtml && (
      <details class="group mt-2">
        <summary class="action cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          {t('common.details')}
        </summary>
        <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink-2" set:html={p.descriptionHtml[locale]} />
      </details>
    )}

    {p.collaborators?.length && (
      <p class="mt-2 text-sm text-ink-3">{t('common.jointWith')} {joinPeople(p.collaborators, locale)}.</p>
    )}

    {stack.length > 0 && <p class="meta mt-2">{stack.join(' · ')}</p>}

    {(p.links.length > 0 || p.citation) && (
      <div class="mt-3 flex flex-wrap items-baseline gap-x-5 gap-y-2">
        <LinkList links={p.links} locale={locale} coldStart={p.coldStart} />
        {p.citation && <button type="button" class="action" data-dialog={`cite-${p.citation.key}`}>{t('common.bibtex')}</button>}
      </div>
    )}
  </div>
  {p.citation && <CiteDialog citation={p.citation} locale={locale} />}
</article>
