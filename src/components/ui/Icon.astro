const { name, class: className = 'h-4 w-4', label } = Astro.props;
const icon = icons[name];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? 'none' : 'currentColor'}
  stroke-width={icon.fill ? undefined : 1.75}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
>
  <path d={icon.d} fill-rule={'evenodd' in icon ? 'evenodd' : undefined} clip-rule={'evenodd' in icon ? 'evenodd' : undefined} />
</svg>
