---
// Section heading over a hairline: `Title                    View all →`.
// With `gutter`, the title starts after the 7rem date column of the entries
// below it, so headings and entries line up on long pages. `number` is
// accepted and not shown (the numbered headings went with the 2026 redesign).

interface Props {
  number?: string;
  title: string;
  id?: string;
  href?: string;
  hrefLabel?: string;
  /** Heading level; section headings on a page are h2. */
  as?: 'h2' | 'h3';
  gutter?: boolean;
  /** Hide the link on small screens (the page repeats it after the section). */
  linkDesktopOnly?: boolean;
}

const { number, title, id, href, hrefLabel, as: Tag = 'h2', gutter = false, linkDesktopOnly = false } = Astro.props;
---

<div class:list={['mb-6 border-b border-line pb-2', gutter && 'sm:grid sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-x-6']}>
  {gutter && <span class="hidden sm:block" aria-hidden="true"></span>}
  <div class="flex min-w-0 items-baseline justify-between gap-4">
    <Tag id={id} class="min-w-0 scroll-mt-24 text-[1.5rem] font-semibold leading-tight tracking-[-0.01em] text-ink text-balance">{title}</Tag>
    {href && (
      <a href={href} class:list={['action shrink-0', linkDesktopOnly && '!hidden sm:!inline-flex']}>
        {hrefLabel}
      </a>
    )}
  </div>
</div>
