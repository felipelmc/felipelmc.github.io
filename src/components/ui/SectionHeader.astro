---
// Numbered section heading: `01  Title ─────────── View all →`
import Icon from './Icon.astro';

interface Props {
  number?: string;
  title: string;
  id?: string;
  href?: string;
  hrefLabel?: string;
  /** Heading level; section headings on a page are h2. */
  as?: 'h2' | 'h3';
}

const { number, title, id, href, hrefLabel, as: Tag = 'h2' } = Astro.props;
---

<div class="mb-7 flex items-center gap-3 sm:gap-4">
  {number && <span class="shrink-0 font-mono text-meta text-accent" aria-hidden="true">{number}</span>}
  <Tag id={id} class="min-w-0 text-[1.5rem] font-semibold leading-tight tracking-[-0.02em] text-ink text-balance sm:text-[1.625rem]">{title}</Tag>
  <span class="h-px min-w-4 flex-1 bg-line" aria-hidden="true"></span>
  {href && (
    <a href={href} class="group inline-flex shrink-0 items-center gap-1.5 text-sm text-ink-2 transition-colors duration-150 hover:text-accent">
      {hrefLabel}
      <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform duration-150 group-hover:translate-x-0.5" />
    </a>
  )}
</div>
