---
import Icon from './ui/Icon.astro';
import { asLocale, getLocalePath, useTranslations } from '../i18n/utils';

const locale = asLocale(Astro.currentLocale);
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;

// The same page in the other language: add or strip the /pt-br prefix.
const otherLocalePath = locale === 'en'
  ? `/pt-br${currentPath === '/' ? '' : currentPath}`
  : currentPath.replace(/^\/pt-br/, '') || '/';

const home = getLocalePath(locale, '/');
const navItems = [
  { href: getLocalePath(locale, '/projects'), label: t('nav.projects') },
  { href: getLocalePath(locale, '/publications'), label: t('nav.research') },
  { href: getLocalePath(locale, '/teaching'), label: t('nav.teaching') },
  { href: getLocalePath(locale, '/cv'), label: t('nav.cv') },
];

const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas/85 backdrop-blur-md" data-print-hide>
  <nav class="mx-auto flex h-14 max-w-content items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="Main">
    <a href={home} class="group flex items-center gap-2.5 rounded-btn" aria-label={`Felipe Lamarca · ${t('nav.home')}`}>
      <span class="grid h-7 w-7 place-items-center rounded-[7px] bg-accent font-mono text-[11px] font-semibold tracking-tight text-accent-ink" aria-hidden="true">FL</span>
      <span class="text-[0.9375rem] font-medium tracking-[-0.01em] text-ink transition-colors duration-150 group-hover:text-accent">Felipe Lamarca</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 md:flex">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative block rounded-btn px-3 py-1.5 text-sm transition-colors duration-150',
                isActive(item.href)
                  ? 'text-ink after:absolute after:inset-x-3 after:-bottom-[13px] after:h-0.5 after:bg-accent'
                  : 'text-ink-2 hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href={otherLocalePath}
        hreflang={locale === 'en' ? 'pt-BR' : 'en'}
        class="ml-1 flex items-center rounded-btn border border-line px-2 py-1 font-mono text-[11px] tracking-[0.06em] text-ink-3 transition-colors duration-150 hover:border-line-strong hover:text-ink"
        aria-label={t('nav.switchLabel')}
        title={t('nav.switchLabel')}
      >
        <span class={locale === 'en' ? 'text-ink' : ''}>EN</span>
        <span class="px-1 text-line-strong" aria-hidden="true">/</span>
        <span class={locale === 'pt-br' ? 'text-ink' : ''}>PT</span>
      </a>

      <button
        id="theme-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-btn text-ink-3 transition-colors duration-150 hover:bg-sunken hover:text-ink"
        aria-label={t('nav.theme')}
        aria-pressed="false"
      >
        <Icon name="sun" class="hidden h-[18px] w-[18px] dark:block" />
        <Icon name="moon" class="block h-[18px] w-[18px] dark:hidden" />
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-btn text-ink-2 transition-colors duration-150 hover:bg-sunken hover:text-ink md:hidden"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line md:hidden">
    <ul class="mx-auto max-w-content px-4 py-2 sm:px-6">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between border-b border-line py-3 text-base last:border-0',
              isActive(item.href) ? 'text-accent' : 'text-ink',
            ]}
          >
            {item.label}
            <Icon name="arrow-right" class="h-4 w-4 text-ink-3" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  const syncTheme = () => {
    const isDark = document.documentElement.classList.contains('dark');
    themeToggle?.setAttribute('aria-pressed', String(isDark));
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', isDark ? '#0B0D10' : '#F6F6F3');
  };
  syncTheme();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    syncTheme();
  });

  const setMenu = (open: boolean) => {
    mobileMenu?.classList.toggle('hidden', !open);
    mobileMenuToggle?.setAttribute('aria-expanded', String(open));
  };

  mobileMenuToggle?.addEventListener('click', () => {
    setMenu(mobileMenu?.classList.contains('hidden') ?? false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      setMenu(false);
      mobileMenuToggle?.focus();
    }
  });
</script>
